# Copia este archivo como envios/.env y rellénalo. envios/.env no se sube a GitHub.

# Web publicada (o http://localhost:5173 para probar en local)
SITIO_URL=https://avisa-bolivia.com
# El mismo valor que el secreto FORWARD_SECRET de la web (mínimo 32 caracteres)
FORWARD_SECRET=

# Minutos de espera antes de enviar un aviso, para que su autor pueda retirarlo
ESPERA_MINUTOS=10

# Tu correo. Gmail: smtp.gmail.com y una «contraseña de aplicación»
# (myaccount.google.com/apppasswords, requiere verificación en dos pasos).
# Outlook/Hotmail: smtp-mail.outlook.com, puerto 587.
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=465
SMTP_USUARIO=tu.correo@gmail.com
SMTP_CONTRASENA=
# Nombre que verán las entidades
REMITENTE="Bolivia Avisa <tu.correo@gmail.com>"
